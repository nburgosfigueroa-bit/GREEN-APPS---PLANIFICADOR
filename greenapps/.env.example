# Variables de entorno de GreenApps — PLANTILLA
# Copiar este archivo como .env y completar los valores REALES
# ⚠️  NUNCA pongas credenciales reales en este archivo

# =============================================
# SUPABASE (Fase 2)
# =============================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXX
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXXXXXXXX
SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json

# =============================================
# MICROSOFT / ONEDRIVE (Fase 3)
# =============================================
AZURE_CLIENT_ID=tu_client_id
AZURE_TENANT_ID=tu_tenant_id
ONEDRIVE_FOLDER_ROOT=GreenApps

# =============================================
# EMAIL NOTIFICATIONS (Fase 3)
# =============================================
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=notificaciones@tudominio.cl

# =============================================
# APP CONFIG
# =============================================
APP_NAME=GreenApps
APP_VERSION=1.0.0
APP_ENV=development
CONTRATO_DEFAULT=Maipú Zona 6 (AKRO)
